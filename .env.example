# Server-side EmailJS settings used by the Vercel checkout function.
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_ADMIN_TEMPLATE_ID=your_admin_template_id
EMAILJS_CLIENT_TEMPLATE_ID=your_client_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=
EMAILJS_ADMIN_EMAIL=orders@example.com

# Allowed frontend origins (comma-separated). Add the production origin here and in the EmailJS dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAILJS_SOURCE_ORIGIN=http://localhost:5173

# Public Sanity catalog settings
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
